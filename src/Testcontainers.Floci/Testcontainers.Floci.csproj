<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0;netstandard2.0;netstandard2.1</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Label="Package">
    <PackageId>Testcontainers.Floci</PackageId>
    <Authors>Testcontainers.Floci contributors</Authors>
    <Description>A Testcontainers for .NET module for Floci, a free, open-source local AWS emulator.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/FinLegal/testcontainers-floci-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/FinLegal/testcontainers-floci-dotnet</RepositoryUrl>
    <PackageTags>testcontainers;floci;aws;localstack;emulator;testing;docker</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations" Version="2025.2.4" />
    <PackageReference Include="Testcontainers" Version="4.12.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Testcontainers.Floci.Tests" />
  </ItemGroup>

</Project>
